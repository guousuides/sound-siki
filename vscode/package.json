{
  "name": "typing-demon",
  "displayName": "sound-siki — タイピングのリズムに寄り添う環境音",
  "description": "エディタの打鍵リズムに合わせて電車や蝉などの環境音をリアルタイム合成します。音声ファイル 0 バイト。",
  "version": "0.1.0",
  "publisher": "guousui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/guousuides/sound-siki",
    "directory": "vscode"
  },
  "homepage": "https://github.com/guousuides/sound-siki#readme",
  "bugs": {
    "url": "https://github.com/guousuides/sound-siki/issues"
  },
  "keywords": [
    "ambient",
    "soundscape",
    "typing",
    "focus",
    "train",
    "環境音",
    "電車"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "demon.start",
        "title": "乗車する (Start)",
        "category": "sound-siki"
      },
      {
        "command": "demon.stop",
        "title": "降りる (Stop)",
        "category": "sound-siki"
      },
      {
        "command": "demon.toggle",
        "title": "乗る／降りる (Toggle)",
        "category": "sound-siki"
      },
      {
        "command": "demon.keySource",
        "title": "打鍵の拾い方を切り替える (エディタ／PC 全体)",
        "category": "sound-siki"
      },
      {
        "command": "demon.mixer",
        "title": "音量ミキサー (全体・電車・蝉・車内放送)",
        "category": "sound-siki"
      },
      {
        "command": "demon.setup",
        "title": "Python 環境を作り直す",
        "category": "sound-siki"
      }
    ],
    "configuration": {
      "title": "sound-siki",
      "properties": {
        "demon.pythonPath": {
          "type": "string",
          "default": "",
          "description": "venv を作るのに使う Python 3.9+。空なら自動 (Windows: py -3 / python, macOS: python3)。"
        },
        "demon.demons": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "train",
              "cicada"
            ]
          },
          "default": [
            "train"
          ],
          "description": "再生する環境音（train: 電車, cicada: 蝉）"
        },
        "demon.volume": {
          "type": "number",
          "default": 0.65,
          "minimum": 0,
          "maximum": 1,
          "description": "全体の音量 (0〜1)。走行中に変えてもその場で効く"
        },
        "demon.trainVolume": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 2,
          "description": "電車の走行音だけの音量倍率 (0〜2)。走行中に変えてもその場で効く"
        },
        "demon.cicadaVolume": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 2,
          "description": "蝉・風鈴だけの音量倍率 (0〜2)。走行中に変えてもその場で効く"
        },
        "demon.announceVolume": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 2,
          "description": "車内放送だけの音量倍率 (0〜2、既定 1)。環境音の音量 demon.volume とは別に掛かる。走行中に変えてもその場で効く"
        },
        "demon.voice": {
          "type": "string",
          "enum": [
            "auto",
            "voicevox",
            "synth"
          ],
          "default": "auto",
          "description": "車内放送の声"
        },
        "demon.autoStartVoicevox": {
          "type": "boolean",
          "default": true,
          "description": "乗車時に VOICEVOX エンジンが止まっていたら自動で起動する（VS Code を閉じると一緒に止める）"
        },
        "demon.voicevoxEnginePath": {
          "type": "string",
          "default": "",
          "description": "VOICEVOX エンジン (vv-engine の run.exe / run) の場所。空なら標準のインストール先を探す"
        },
        "demon.speaker": {
          "type": "integer",
          "default": 3,
          "description": "VOICEVOX の話者スタイル ID"
        },
        "demon.keySource": {
          "type": "string",
          "enum": [
            "editor",
            "global"
          ],
          "default": "editor",
          "enumDescriptions": [
            "この IDE のエディタでの入力だけを見る (権限不要)",
            "PC 全体のキーボードを監視する (pynput)。ブラウザやチャットで打っても走る。macOS はアクセシビリティ許可が必要"
          ],
          "description": "打鍵をどこから取るか"
        },
        "demon.noExit": {
          "type": "boolean",
          "default": false,
          "description": "目的駅に着いても終了しない"
        }
      }
    }
  },
  "scripts": {
    "bundle": "node scripts/bundle.js",
    "vscode:prepublish": "node scripts/bundle.js",
    "package": "npx @vscode/vsce package"
  }
}
